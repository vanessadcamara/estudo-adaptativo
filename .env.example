# Copie para .env e preencha APENAS na sua máquina.
# .env nunca deve ser enviado ao GitHub.
# Local: PostgreSQL instalado no computador.
# Neon: copie a connection string do painel, mantenha ?sslmode=require.
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/estudo_bb

APP_ENV=development
ADMIN_USERNAME=estudante
# Gere usando: python -m app.auth hash-password
ADMIN_PASSWORD_HASH=
# Gere usando: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=
